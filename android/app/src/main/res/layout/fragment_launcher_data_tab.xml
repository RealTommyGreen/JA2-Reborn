<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/launcher_panel"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/gameVersionInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_version_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gameVersionInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/game_version_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/gameVersionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:contentDescription="@string/game_version_empty_text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/gameDirInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_dir_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gameDirInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/game_dir_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/gameDirValueText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:ellipsize="middle"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/game_dir_empty_text"
                    android:textColor="#FFF3E6D7"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/gameDirChooseButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/launcher_button"
                    android:maxLines="1"
                    android:text="@string/select_directory_button_label"
                    android:textAllCaps="false"
                    android:textColor="#FFFFF3E6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/saveGameDirInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/save_game_dir_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/saveGameDirInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/save_game_dir_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/saveGameDirValueText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:ellipsize="middle"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/save_game_dir_empty_text"
                    android:textColor="#FFF3E6D7"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/saveGameDirChooseButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/launcher_button"
                    android:maxLines="1"
                    android:text="@string/select_directory_button_label"
                    android:textAllCaps="false"
                    android:textColor="#FFFFF3E6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/externalized_json_dir_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/externalized_json_dir_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/externalizedJsonDirValueText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:ellipsize="middle"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/externalized_json_dir_empty_text"
                    android:textColor="#FFF3E6D7"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/externalizedJsonDirChooseButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/launcher_button"
                    android:maxLines="1"
                    android:text="@string/select_directory_button_label"
                    android:textAllCaps="false"
                    android:textColor="#FFFFF3E6" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/launcher_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/resolutionInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/resolution_info_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resolutionInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/resolution_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/resolutionModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:contentDescription="@string/resolution_info_title_text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/expertSettingsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <CheckBox
                    android:id="@+id/expertSettingsCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="#FFD4A84F"
                    android:text="@string/expert_settings_label"
                    android:textColor="#FFFFF3E6"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/manualResolutionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/manualResolutionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/manual_resolution_label"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/manualResolutionFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/resolutionWidthEditText"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/launcher_surface"
                        android:hint="@string/manual_resolution_width_hint"
                        android:inputType="number"
                        android:maxLength="5"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:selectAllOnFocus="true"
                        android:textColor="#FFFFF3E6"
                        android:textColorHint="#88E7D6C4" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="x"
                        android:textColor="#DDE7D6C4"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/resolutionHeightEditText"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/launcher_surface"
                        android:hint="@string/manual_resolution_height_hint"
                        android:inputType="number"
                        android:maxLength="5"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:selectAllOnFocus="true"
                        android:textColor="#FFFFF3E6"
                        android:textColorHint="#88E7D6C4" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/scalingQualityInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scaling_quality_info_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scalingQualityInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/scaling_quality_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/scalingQualitySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:contentDescription="@string/scaling_quality_info_title_text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_panel"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/mouseModeInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mouse_mode_info_title_text"
                    android:textColor="#FFFFF3E6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mouseModeInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mouse_mode_info_text"
                    android:textColor="#DDE7D6C4"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/mouseModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/launcher_surface"
                    android:contentDescription="@string/mouse_mode_info_title_text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
